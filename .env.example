# Copier en .env puis remplir avec `npx supabase status` (valeurs locales).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL publique du site (sitemap, liens de partage)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Données d’exemple du tableau de bord (le SaaS de Nadia) : poste de développement et tests
# uniquement. Jamais en production, où tout reste vide tant que l’utilisateur n’a rien fourni.
DEMO_DATA=true

# Stripe SIMULÉ (/api/stripe-mock) : poste de développement et tests uniquement, valeurs factices.
# En production : vraies clés (STRIPE_SECRET_KEY, STRIPE_CONNECT_CLIENT_ID) et rien d’autre.
STRIPE_MOCK=true
STRIPE_SECRET_KEY=sk_test_mock
STRIPE_CONNECT_CLIENT_ID=ca_mock
STRIPE_API_BASE=http://localhost:3001/api/stripe-mock
STRIPE_CONNECT_BASE=http://localhost:3001/api/stripe-mock

# Resynchronisation Stripe (route /api/stripe/sync) : valeur factice en local et en CI.
CRON_SECRET=cron_secret_local_test

# Notifications de Stripe sur l’abonnement de SaasClair : valeur factice en local et en CI
# (le Stripe simulé signe avec ce même secret).
STRIPE_WEBHOOK_SECRET=whsec_mock_local

# Notifications des comptes Stripe connectés par les clients (Connect) : valeur factice en
# local et en CI.
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_mock_connect_local
